{
  "name": "tech-mentor-studio",
  "version": "0.1.0",
  "description": "Visual Local-First Workbench for Code Walking and AI Tech Mentoring",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js && bash -n start.sh",
    "build": "node scripts/build-assets.js",
    "prestart": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "express": "^4.21.2",
    "highlight.js": "11.9.0",
    "lucide": "1.55.0",
    "marked": "18.1.1",
    "mermaid": "10.9.8"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
